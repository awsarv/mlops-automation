{
  "annotations": { "list": [] },
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "liveNow": false,
  "schemaVersion": 39,
  "style": "dark",
  "tags": ["mlops", "fastapi", "prometheus", "fraud-detection"],
  "templating": {
    "list": [
      {
        "name": "datasource",
        "type": "datasource",
        "query": "prometheus",
        "hide": 0,
        "label": "Datasource",
        "current": {},
        "options": []
      },
      {
        "name": "job",
        "type": "query",
        "datasource": { "type": "prometheus", "uid": "$datasource" },
        "label": "Job",
        "includeAll": false,
        "multi": false,
        "query": "label_values(up, job)",
        "current": { "selected": true, "text": "fraud-api", "value": "fraud-api" },
        "refresh": 2
      },
      {
        "name": "instance",
        "type": "query",
        "datasource": { "type": "prometheus", "uid": "$datasource" },
        "label": "Instance",
        "includeAll": false,
        "multi": false,
        "query": "label_values(up{job=\"$job\"}, instance)",
        "refresh": 2
      }
    ]
  },
  "time": { "from": "now-6h", "to": "now" },
  "timepicker": { "refresh_intervals": ["5s", "10s", "30s", "1m", "5m"] },
  "title": "Fraud Detection API - Overview",
  "uid": "fraud-api-overview",
  "version": 1,
  "panels": [
    {
      "type": "stat",
      "title": "Target Up",
      "gridPos": { "h": 4, "w": 4, "x": 0, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "$datasource" },
      "targets": [
        { "expr": "avg_over_time(up{job=\"$job\", instance=~\"$instance\"}[5m])", "legendFormat": "up" }
      ],
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "colorMode": "value",
        "textMode": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [{ "color": "red", "value": 0 }, { "color": "green", "value": 1 }]
          }
        }
      }
    },
    {
      "type": "stat",
      "title": "Total Predictions",
      "gridPos": { "h": 4, "w": 4, "x": 4, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "$datasource" },
      "targets": [
        { "expr": "sum(fraud_predictions_total{job=\"$job\", instance=~\"$instance\"})", "legendFormat": "total" }
      ],
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] } }
    },
    {
      "type": "stat",
      "title": "Fraud Flagged",
      "gridPos": { "h": 4, "w": 4, "x": 8, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "$datasource" },
      "targets": [
        { "expr": "sum(fraud_transactions_flagged_total{job=\"$job\", instance=~\"$instance\"})", "legendFormat": "flagged" }
      ],
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] } },
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [{ "color": "green", "value": 0 }, { "color": "yellow", "value": 10 }, { "color": "red", "value": 100 }]
          }
        }
      }
    },
    {
      "type": "stat",
      "title": "Avg Latency (ms)",
      "gridPos": { "h": 4, "w": 4, "x": 12, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "$datasource" },
      "targets": [
        {
          "expr": "1000 * (sum(rate(fraud_inference_latency_seconds_sum{job=\"$job\", instance=~\"$instance\"}[5m])) / sum(rate(fraud_inference_latency_seconds_count{job=\"$job\", instance=~\"$instance\"}[5m])))",
          "legendFormat": "avg"
        }
      ],
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] } }
    },
    {
      "type": "timeseries",
      "title": "Predictions per Second (OK vs Error)",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 4 },
      "datasource": { "type": "prometheus", "uid": "$datasource" },
      "targets": [
        {
          "expr": "sum by (status) (rate(fraud_predictions_total{job=\"$job\", instance=~\"$instance\"}[5m]))",
          "legendFormat": "{{status}} rps"
        }
      ],
      "options": { "legend": { "displayMode": "list", "placement": "bottom" } }
    },
    {
      "type": "timeseries",
      "title": "Latency: p50 / p90 / p95 / p99 (ms)",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 4 },
      "datasource": { "type": "prometheus", "uid": "$datasource" },
      "targets": [
        {
          "expr": "1000 * histogram_quantile(0.50, sum by (le) (rate(fraud_inference_latency_seconds_bucket{job=\"$job\", instance=~\"$instance\"}[5m])))",
          "legendFormat": "p50"
        },
        {
          "expr": "1000 * histogram_quantile(0.90, sum by (le) (rate(fraud_inference_latency_seconds_bucket{job=\"$job\", instance=~\"$instance\"}[5m])))",
          "legendFormat": "p90"
        },
        {
          "expr": "1000 * histogram_quantile(0.95, sum by (le) (rate(fraud_inference_latency_seconds_bucket{job=\"$job\", instance=~\"$instance\"}[5m])))",
          "legendFormat": "p95"
        },
        {
          "expr": "1000 * histogram_quantile(0.99, sum by (le) (rate(fraud_inference_latency_seconds_bucket{job=\"$job\", instance=~\"$instance\"}[5m])))",
          "legendFormat": "p99"
        }
      ],
      "options": { "legend": { "displayMode": "list", "placement": "bottom" } }
    },
    {
      "type": "timeseries",
      "title": "Fraud Detection Rate (%)",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 12 },
      "datasource": { "type": "prometheus", "uid": "$datasource" },
      "targets": [
        {
          "expr": "100 * sum(rate(fraud_predictions_total{result=\"fraud\", job=\"$job\", instance=~\"$instance\"}[5m])) / sum(rate(fraud_predictions_total{job=\"$job\", instance=~\"$instance\"}[5m]))",
          "legendFormat": "fraud %"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "percent" } }
    },
    {
      "type": "timeseries",
      "title": "Transaction Amount Distribution",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 12 },
      "datasource": { "type": "prometheus", "uid": "$datasource" },
      "targets": [
        {
          "expr": "sum by (le) (rate(transaction_amount_dollars_bucket{job=\"$job\", instance=~\"$instance\"}[5m]))",
          "legendFormat": "{{le}}"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Model Confidence Distribution",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 20 },
      "datasource": { "type": "prometheus", "uid": "$datasource" },
      "targets": [
        {
          "expr": "histogram_quantile(0.50, sum by (le) (rate(fraud_model_confidence_bucket{job=\"$job\", instance=~\"$instance\"}[5m])))",
          "legendFormat": "p50 confidence"
        },
        {
          "expr": "histogram_quantile(0.90, sum by (le) (rate(fraud_model_confidence_bucket{job=\"$job\", instance=~\"$instance\"}[5m])))",
          "legendFormat": "p90 confidence"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Process Memory (RSS)",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 20 },
      "datasource": { "type": "prometheus", "uid": "$datasource" },
      "targets": [
        {
          "expr": "process_resident_memory_bytes{job=\"$job\", instance=~\"$instance\"}",
          "legendFormat": "rss"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "bytes" } }
    }
  ]
}
